{
  "schemaVersion": 3,
  "paths": {
    "reposRoot": "d:\\Scanner\\Repos",
    "runs": "d:\\Scanner\\runs",
    "state": "d:\\Scanner\\state",
    "tmp": "d:\\Scanner\\tmp",
    "logs": "d:\\Scanner\\logs"
  },
  "statusIntervalSeconds": 2,
  "commandIntervalSeconds": 2,
  "sources": [
    { "source": "ADO", "name": "ADOVizientInc", "org": "vizientinc",  "tokenSecret": "ado-pat" , "orgs": [ "vizientinc" ]},
    { "source": "ADO", "name": "ADOClaroHealthCareADO", "org": "clarohealthcare", "tokenSecret": "clarohealthcare-pat" },
    { "source": "GitHub", "name": "GitHubPrefTech", "tokenSecret": "github-token", "includeOwnRepos": true, "orgs": [ "preftech" ] },
    { "source": "GitHub", "name": "GitHubAptitudeMarketplace", "tokenSecret": "github-token", "includeOwnRepos": true, "orgs": [ "aptitudemarketplace" ] },
    { "source": "GitHub", "name": "GitHubSafeAndReliable", "tokenSecret": "github-token", "includeOwnRepos": true, "orgs": [ "safeandreliable" ] },
    { "source": "GitHub", "name": "GitHubVizientInc", "tokenSecret": "vizientinc-pat", "includeOwnRepos": true, "orgs": [ "vizientinc" ] },
    { "source": "GitHub", "name": "GitHubRnD-Vizient", "tokenSecret": "rnd_vizient-pat", "includeOwnRepos": true, "orgs": [ "RnD-Vizient"] }
  ],
  "scanArchived": false,
  "skip": { "enabled": true, "canaryPercent": 5, "fullRescanEveryDays": 30 },
  "retry": { "maxAttempts": 2, "backoffSeconds": 60 },
  "tools": {
    "Rapid7": {
      "enabled": true,
      "tokenSecret": "rapid7-token",
      "baseUrl": "https://us.api.insight.rapid7.com/ias/v1",
      "authMode": "api_key",
      "pageSize": 100
    },
    "CheckMarx": {
      "enabled": true,
      "tokenSecret": "checkmarx-token",
      "baseUrl": "https://us.ast.checkmarx.net",
      "tenant": "vizient-inc",
      "clientId": "ast-app",
      "pageSize": 100
    },
    "RepoClone": {
      "enabled": true,
      "maxParallel": 12,
      "timeoutMinutes": 60,
      "longPaths": true
    },
    "TruffleHog": {
      "enabled": true,
      "maxParallel": 8,
      "timeoutMinutes": 30,
      "version": "3.x",
      "rulesVersion": "detectors-3.x",
      "mode": "filesystem",
      "verify": true
    },
    "Semgrep": {
      "enabled": true,
      "maxParallel": 8,
      "timeoutMinutes": 30,
      "version": "1.x",
      "rulesVersion": "p/default@2026-10-01",
      "packs": [ "p/default", "p/owasp-top-ten", "p/cwe-top-25" ]
    },
    "Snyk": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 45,
      "version": "1.x",
      "rulesVersion": "n/a",
      "mode": "code",
      "env": { "SNYK_TOKEN": "snyk-token" }
    },
    "SonarStandard": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 60,
      "exePath": "C:\\Tools\\sonar-scanner\\bin\\sonar-scanner.bat",
      "version": "8.1.0.6389",
      "rulesVersion": "profile-2026-10-01",
      "serverUrl": "http://localhost:9000",
      "env": { "SONAR_TOKEN": "sonar_token" }
    },
    "SonarDotNet": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 60,
      "version": "10.x",
      "rulesVersion": "profile-example",
      "msbuildScannerPath": "C:\\Tools\\sonar-scanner-msbuild\\SonarScanner.MSBuild.exe",
      "msbuildScannerVersion": "11.3",
      "fallbackToStandardScanner": true,
      "serverUrl": "http://localhost:9000",
      "env": { "SONAR_TOKEN": "sonar_token" },
      "runAs": { "account": "ADFW5P02SEC\\sonarqube", "passwordSecret": "buildtools-account-password" }
    }
  }
}
