{
  "schemaVersion": 3,
  "paths": {
    "reposRoot": "D:\\Repos",
    "runs": "D:\\Scanner\\runs",
    "state": "D:\\Scanner\\state",
    "tmp": "D:\\Scanner\\tmp",
    "logs": "D:\\Scanner\\logs"
  },
  "statusIntervalSeconds": 2,
  "commandIntervalSeconds": 2,
  "sources": [
    { "source": "ADO", "org": "vizientinc", "tokenSecret": "ado-pat" },
    { "source": "ADO", "org": "RnD-Vizient", "tokenSecret": "ado-pat" },
    { "source": "ADO", "org": "clarohealthcare", "tokenSecret": "clarohealthcare-pat" },
    { "source": "GitHub", "org": "preftech", "tokenSecret": "github-token" },
    { "source": "GitHub", "org": "aptitudemarketplace", "tokenSecret": "github-token" },
    { "source": "GitHub", "org": "safeandreliable", "tokenSecret": "github-token" }
  ],
  "scanArchived": false,
  "skip": { "enabled": true, "canaryPercent": 5, "fullRescanEveryDays": 30 },
  "retry": { "maxAttempts": 2, "backoffSeconds": 60 },
  "tools": {
    "Rapid7": {
      "enabled": true,
      "tokenSecret": "rapid7-token",
      "baseUrl": "https://us.api.insight.rapid7.com/ias/v1",
      "authMode": "api_key",
      "pageSize": 100
    },
    "CheckMarx": {
      "enabled": true,
      "tokenSecret": "checkmarx-token",
      "baseUrl": "https://us.ast.checkmarx.net",
      "tenant": "vizient-inc",
      "clientId": "ast-app",
      "pageSize": 100
    },
    "RepoClone": {
      "enabled": true,
      "maxParallel": 12,
      "timeoutMinutes": 60,
      "longPaths": true
    },
    "TruffleHog": {
      "enabled": true,
      "maxParallel": 8,
      "timeoutMinutes": 30,
      "version": "3.x",
      "rulesVersion": "detectors-3.x",
      "mode": "filesystem",
      "verify": false
    },
    "Semgrep": {
      "enabled": true,
      "maxParallel": 8,
      "timeoutMinutes": 30,
      "version": "1.x",
      "rulesVersion": "p/default@2026-10-01",
      "packs": [ "p/default", "p/owasp-top-ten", "p/cwe-top-25" ]
    },
    "Snyk": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 45,
      "version": "1.x",
      "rulesVersion": "n/a",
      "mode": "code",
      "env": { "SNYK_TOKEN": "snyk-token" },
      "runAs": { "account": "DOMAIN\\svc-buildtools", "passwordSecret": "buildtools-account-password" }
    },
    "SonarStandard": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 60,
      "version": "10.x",
      "rulesVersion": "profile-2026-10-01",
      "serverUrl": "http://localhost:9000",
      "env": { "SONAR_TOKEN": "sonar-token" }
    },
    "SonarDotNet": {
      "enabled": true,
      "maxParallel": 4,
      "timeoutMinutes": 60,
      "version": "10.x",
      "rulesVersion": "profile-2026-10-01",
      "serverUrl": "http://localhost:9000",
      "env": { "SONAR_TOKEN": "sonar-token" },
      "runAs": { "account": "DOMAIN\\svc-buildtools", "passwordSecret": "buildtools-account-password" }
    }
  }
}
